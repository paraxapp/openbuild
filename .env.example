NODE_ENV=production
PORT=10000
# Primary auth DB (users always live here). Keep 'neon'.
PRIMARY_AUTH_DB=neon
# Per-project storage: user picks neon or supabase at project creation.
NEON_DATABASE_URL=postgresql://user:pass@neon-host/db?sslmode=require
SUPABASE_DATABASE_URL=postgresql://user:pass@supabase-host/db?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-app.onrender.com
